<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network permissions for GitHub In-App Updater -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- GPS Speedometer Permissions -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Ability to list all installed applications on Android 11+ (API 30+) -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Non-mandatory hardware features so the APK installs on any device/head unit -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application
        android:name=".CarLauncherApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.CarLauncher">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:clearTaskOnLaunch="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustPan">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".CrashActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:theme="@style/Theme.CarLauncher" />

        <!-- BroadcastReceiver for capturing head unit radio status events -->
        <receiver
            android:name=".service.RadioBroadcastReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.qf.radio.update_action" />
                <action android:name="com.qf.action.RADIO" />
                <action android:name="com.qf.action.RADIO_INFO" />
                <action android:name="com.qf.action.RADIO_STATE" />
                <action android:name="com.qf.radio" />
                <action android:name="com.qf.fmradio" />
                <action android:name="com.qf.radio.REPORT" />
                <action android:name="com.qf.radio.action" />
                <action android:name="com.allwinner.radio.station_changed" />
                <action android:name="com.allwinner.radio.REPORT" />
                <action android:name="com.allwinner.action.RADIO_INFO" />
                <action android:name="com.softwinner.radio.station_changed" />
                <action android:name="com.softwinner.radio.REPORT" />
                <action android:name="com.nwd.action.ACTION_SEND_RADIO_FREQUENCE_NEW" />
                <action android:name="ACTION_SEND_RADIO_FREQUENCE_NEW" />
                <action android:name="com.nwd.radio.freq_action" />
                <action android:name="com.nwd.radio.change" />
                <action android:name="com.nwd.radio.status" />
                <action android:name="com.nwd.radio.update_action" />
                <action android:name="com.nwd.action.ACTION_RADIO_INFO" />
                <action android:name="com.nwd.action.ACTION_RADIO_STATE" />
                <action android:name="com.nwd.action.RADIO_STATUS_CHANGED" />
                <action android:name="com.nwd.action.ACTION_SEND_RADIO_INFO" />
                <action android:name="com.nwd.action.RADIO_INFO" />
                <action android:name="com.nwd.action.RADIO_FREQUENCE" />
                <action android:name="com.nwd.action.RADIO_STATUS" />
                <action android:name="com.nwd.radio.REPORT" />
                <action android:name="com.nwd.radio" />
                <action android:name="com.nwd.link.radio.freq" />
                <action android:name="com.nwd.link.radio" />
                <action android:name="com.nwd.radio.broadcast" />
                <action android:name="com.nwd.radio.CURRENT_FREQ" />
                <action android:name="nwd.radio.cur_freq" />
                <action android:name="com.nwd.ACTION_CHANGE_SOURCE" />
                <action android:name="com.nwd.mcu.radio" />
                <action android:name="com.nwd.kernel.radio" />
                <action android:name="com.nwd.broadcast.RADIO" />
                <action android:name="com.nwd.radio.ACTION_SEND_RADIO_INFO" />
                <action android:name="com.nwd.radio.ACTION_RADIO_FREQ_CHANGED" />
                <action android:name="com.nwd.radio.FREQ_CHANGED" />
                <action android:name="com.nwd.radio.action.STATION_CHANGED" />
                <action android:name="com.nwd.radio.station_changed" />
                <action android:name="com.android.radio.freq" />
                <action android:name="com.android.radio.frequence" />
                <action android:name="com.microntek.radiostate" />
                <action android:name="com.microntek.radio.report" />
                <action android:name="com.syu.radio" />
                <action android:name="com.ts.radio.broadcast" />
                <action android:name="com.navimods.radio.status" />
                <action android:name="com.navimods.radio.station" />
                <action android:name="com.android.music.metachanged" />
                <action android:name="com.android.music.playstatechanged" />
                <action android:name="android.intent.action.RADIO_STATE_CHANGED" />
                <action android:name="android.hardware.radio.action.STATION_CHANGED" />
                <action android:name="com.android.fmradio.FM_FREQUENCY_CHANGED" />
                <action android:name="com.android.fmradio.FM_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- FileProvider for installing downloaded APK updates -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
